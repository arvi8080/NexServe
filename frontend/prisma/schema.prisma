// Prisma Schema for GlowHome Marketplace Platform (PostgreSQL on Neon Cloud)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR_OWNER
  PROFESSIONAL
  ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationCategory {
  BOOKING
  PAYMENT
  WALLET
  PROMOTION
  SECURITY
  SYSTEM
  REVIEW
  CHAT
  ADMIN
}

enum BranchType {
  COMPANY_OWNED
  FRANCHISE
  CORPORATE
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

model Country {
  id              String                 @id @default(uuid())
  name            String
  code            String                 @unique // IN, NP, BD, LK, AE, SG, MY
  currency        String                 // INR, NPR
  currencySymbol  String                 // ₹, रु
  phoneCode       String                 // +91, +977
  timezone        String                 // Asia/Kolkata, Asia/Kathmandu
  defaultLanguage String                 @default("en")
  flag            String                 // 🇮🇳, 🇳🇵
  taxName         String                 @default("GST") // GST, VAT
  taxRate         Float                  @default(18.0) // 18.0%, 13.0%
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  states          State[]
  cities          City[]
  branches        Branch[]
  paymentGateways PaymentGatewayConfig[]
  users           User[]
  vendors         Vendor[]

  @@map("countries")
}

model State {
  id        String   @id @default(uuid())
  countryId String
  name      String
  code      String

  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]
  branches  Branch[]
  users     User[]
  vendors   Vendor[]

  @@map("states")
}

model City {
  id        String   @id @default(uuid())
  stateId   String
  countryId String
  name      String
  latitude  Float
  longitude Float
  active    Boolean  @default(true)

  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  branches  Branch[]
  users     User[]
  vendors   Vendor[]

  @@map("cities")
}

model Branch {
  id          String     @id @default(uuid())
  countryId   String
  stateId     String
  cityId      String
  franchiseId String?
  branchName  String
  branchType  BranchType @default(COMPANY_OWNED)
  managerName String
  email       String
  phone       String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  country   Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  state     State             @relation(fields: [stateId], references: [id], onDelete: Cascade)
  city      City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  franchise FranchisePartner? @relation(fields: [franchiseId], references: [id])
  vendors   Vendor[]
  bookings  Booking[]

  @@map("branches")
}

model FranchisePartner {
  id                   String    @id @default(uuid())
  companyName          String
  ownerName            String
  email                String    @unique
  phone                String
  agreementStart       DateTime
  agreementEnd         DateTime
  commissionPercentage Float     @default(15.0)
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  branches             Branch[]
  bookings             Booking[]

  @@map("franchise_partners")
}

model PaymentGatewayConfig {
  id          String   @id @default(uuid())
  countryId   String
  gatewayName String   // RAZORPAY, PHONEPE, ESEWA, KHALTI, FONEPAY, CASH
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)

  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@map("payment_gateway_configs")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              Role              @default(CUSTOMER)
  avatar            String?
  countryId         String?
  stateId           String?
  cityId            String?
  preferredCurrency String            @default("INR")
  preferredLanguage String            @default("en")
  walletBalance     Float             @default(0.0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  country       Country?          @relation(fields: [countryId], references: [id])
  state         State?            @relation(fields: [stateId], references: [id])
  city          City?             @relation(fields: [cityId], references: [id])
  bookings      Booking[]
  reviews       Review[]
  vendors       Vendor[]
  addresses     CustomerAddress[]
  notifications Notification[]

  @@map("users")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String               @default("INFO")
  category  NotificationCategory @default(SYSTEM)
  priority  NotificationPriority @default(NORMAL)
  read      Boolean              @default(false)
  actionUrl String?
  icon      String?
  createdAt DateTime             @default(now())
  expiresAt DateTime?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String   @default("Home")
  fullName     String
  phoneNumber  String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  country      String   @default("India")
  postalCode   String
  latitude     Float
  longitude    Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Vendor {
  id            String              @id @default(uuid())
  ownerId       String
  countryId     String?
  stateId       String?
  cityId        String?
  branchId      String?
  businessName  String
  description   String?
  phone         String
  address       String
  city          String
  state         String
  zipCode       String
  status        String              @default("PENDING")
  averageRating Float               @default(5.0)
  totalReviews  Int                 @default(0)
  profileImage  String?
  isVerified    Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  owner          User                @relation(fields: [ownerId], references: [id])
  country        Country?            @relation(fields: [countryId], references: [id])
  state          State?              @relation(fields: [stateId], references: [id])
  cityRel        City?               @relation(fields: [cityId], references: [id])
  branch         Branch?             @relation(fields: [branchId], references: [id])
  verification   VendorVerification?
  vendorServices VendorService[]
  bookings       Booking[]
  coverage       VendorCoverage?

  @@map("vendors")
}

model VendorVerification {
  id                        String             @id @default(uuid())
  vendorId                  String             @unique
  govtIdType                String             @default("AADHAAR")
  govtIdNumberEncrypted     String
  policeVerificationDoc     String?
  skillCertificateDoc       String?
  bankAccountHolder         String
  bankAccountNumberEncrypted String
  bankIfscOrBranchCode      String
  bankPayoutPreference      String             @default("UPI")
  trustScore                Int                @default(98)
  status                    VerificationStatus @default(VERIFIED)
  verificationBadges        String[]           @default(["VERIFIED_IDENTITY", "TOP_RATED", "ELITE_PARTNER"])
  reviewedBy                String?
  rejectionReason           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  vendor                    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_verifications")
}

model VendorCoverage {
  id              String   @id @default(uuid())
  vendorId        String   @unique
  city            String
  serviceRadius   Float    @default(10.0)
  latitude        Float
  longitude       Float
  availableCities String[] @default(["Bengaluru"])
  travelCharges   Float    @default(0.0)
  maxDistance     Float    @default(25.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_coverages")
}

// Master Global Catalog Definition (Admin Managed Only)
model Service {
  id              String          @id @default(uuid())
  categoryId      String
  name            String
  description     String
  image           String?
  icon            String?
  slug            String          @unique
  defaultDuration Int             @default(45) // in minutes
  minPrice        Float           @default(300.0) // Admin Min Price Cap
  maxPrice        Float           @default(1500.0) // Admin Max Price Cap
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vendorServices VendorService[]
  bookings       Booking[]

  @@map("services")
}

// Vendor Offering Definition (Vendor Pricing & Locality Managed)
model VendorService {
  id                  String               @id @default(uuid())
  vendorId            String
  serviceId           String
  country             String               @default("IN") // IN, NP
  state               String               @default("Karnataka")
  city                String               @default("Bengaluru")
  area                String               @default("Indiranagar")
  price               Float
  discountPrice       Float?
  discountPercentage  Int?                 @default(0)
  duration            Int
  availableSlots      String[]             @default(["10:00 AM", "02:00 PM", "05:00 PM"])
  genderPreference    String               @default("UNISEX") // FEMALE_ONLY, MALE_ONLY, UNISEX
  experienceYears     Int                  @default(5)
  available           Boolean              @default(true)
  instantBooking      Boolean              @default(true)
  homeService         Boolean              @default(true)
  serviceRadius       Int                  @default(10)
  maxBookingsPerDay   Int                  @default(6)
  status              String               @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  service             Service              @relation(fields: [serviceId], references: [id])
  images              VendorServiceImage[]

  @@map("vendor_services")
}

model VendorServiceImage {
  id              String        @id @default(uuid())
  vendorServiceId String
  imageUrl        String
  isPrimary       Boolean       @default(false)

  vendorService   VendorService @relation(fields: [vendorServiceId], references: [id], onDelete: Cascade)

  @@map("vendor_service_images")
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  vendorId    String
  serviceId   String
  branchId    String?
  franchiseId String?
  bookingDate DateTime
  address     String
  latitude    Float?
  longitude   Float?
  distanceKm  Float?
  travelCost  Float?        @default(0.0)
  notes       String?
  totalAmount Float
  currency    String        @default("INR")
  status      BookingStatus @default(PENDING)
  otpCode     String        @default("4892")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer    User              @relation(fields: [customerId], references: [id])
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  branch      Branch?           @relation(fields: [branchId], references: [id])
  franchise   FranchisePartner? @relation(fields: [franchiseId], references: [id])
  payments    Payment[]

  @@map("bookings")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  booking           Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
