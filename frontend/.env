# ==============================================================================
# GLOWHOME ENTERPRISE PLATFORM (.env)
# ==============================================================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Lean MVP Launch Feature Flags (Direct Vendor Payment, Map-Free Manual Address)
ENABLE_PLATFORM_PAYMENT=false
PAYMENT_MODE=direct
ENABLE_GOOGLE_MAPS=false
DEFAULT_COMMISSION=0

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-cool-pool-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/glowhome_db?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_placeholder@ep-cool-pool-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/glowhome_db?sslmode=require"

# JWT Auth & Security
JWT_ACCESS_SECRET=GlowHome_Access_Secret_Key_2026_123456789
JWT_REFRESH_SECRET=GlowHome_Refresh_Secret_Key_2026_987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=GlowHome_Cookie_Secret_908123

ENCRYPTION_KEY=GlowHome_32_Char_EncryptionKey!
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
SESSION_TIMEOUT=30m
PASSWORD_RESET_EXPIRES=10m
ACCOUNT_LOCK_TIME=15m

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SOCKET_PORT=5000
SOCKET_CORS_ORIGIN=http://localhost:5173

# India Payment Gateway Config (Preserved for future ENABLE_PLATFORM_PAYMENT=true activation)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook
PHONEPE_MERCHANT_ID=PGTESTPAYUAT

# Nepal Payment Gateway Config (Preserved for future activation)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBmStructureKey908
KHALTI_PUBLIC_KEY=Key_Live_Placeholder_123456
KHALTI_SECRET_KEY=Secret_Live_Placeholder_987654
FONEPAY_MERCHANT_CODE=FONEPAY_TEST_001

# Region Defaults
DEFAULT_COUNTRY_CODE=IN
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=Asia/Kolkata
SUPPORTED_COUNTRIES=IN,NP
SUPPORTED_CURRENCIES=INR,NPR
SUPPORTED_LANGUAGES=en,hi,ne

ENABLE_AI=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_WALLET=true
ENABLE_REFERRAL=true
ENABLE_MEMBERSHIP=true

PLATFORM_NAME=GlowHome
PLATFORM_WEBSITE=http://localhost:5173
PLATFORM_SUPPORT_EMAIL=glowhome.help@gmail.com
EMAIL_FROM=glowhome.help@gmail.com

APP_VERSION=1.0.0
BUILD_NUMBER=1
DEPLOYMENT_ENV=development

# Frontend (Vite) Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_ENABLE_PLATFORM_PAYMENT=false
VITE_PAYMENT_MODE=direct
VITE_ENABLE_GOOGLE_MAPS=false
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_DEFAULT_COUNTRY=IN
VITE_SUPPORTED_COUNTRIES=IN,NP
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_CURRENCY=INR
